#!/bin/sh
# Before every push: the typecheck (~20 s), so a red build is caught here
# instead of on GitHub. The build itself runs in CI only (too slow here).
# Skip once, knowingly: git push --no-verify (CI still runs everything).

echo "pre-push: typecheck…"
npx tsc --noEmit -p tsconfig.app.json || {
  echo ""
  echo "pre-push: typecheck failed — push stopped."
  exit 1
}
